<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console host for the shared checks and an ordinary application load context. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>FFAudio.Checks.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../FFAudio.Checks/FFAudio.Checks.csproj" />
  </ItemGroup>

  <!-- In package mode, restore only the native payload for this host OS. -->
  <ItemGroup Condition="'$(FFAudioPackageVersion)' != '' And $([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="FFAudio.NET.Linux" Version="$(FFAudioPackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(FFAudioPackageVersion)' != '' And $([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="FFAudio.NET.macOS" Version="$(FFAudioPackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(FFAudioPackageVersion)' != '' And $([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="FFAudio.NET.Windows" Version="$(FFAudioPackageVersion)" />
  </ItemGroup>

</Project>
