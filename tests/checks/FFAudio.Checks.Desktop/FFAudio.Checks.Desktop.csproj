<Project Sdk="Microsoft.NET.Sdk">

  <!-- The same checks the phones run, on whichever desktop is running it.
       macOS, Linux and Windows in one project, because on a desktop "the
       platform" is a runtime concern and not a build one - there is nothing
       here for a target framework to differ about.

       It overlaps FFAudio.Tests deliberately: DeviceChecksTests already runs
       RunAll under xUnit on all three. What that cannot answer is whether an
       ordinary application - a console app with a PackageReference and a
       Main - can use this library, because a test host restores, resolves and
       loads differently from an app. Something an app does and a test does
       not is exactly the class of thing that has bitten this library twice on
       iOS. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>FFAudio.Checks.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../FFAudio.Checks/FFAudio.Checks.csproj" />
  </ItemGroup>

  <!-- With $(FFAudioPackageVersion) set, the native comes from this desktop's
       payload package instead of the tree, the way it reaches a consumer: the
       package puts it under runtimes/<rid>/native/, the host copies it out,
       and Native.Resolve finds it by name. Only this machine's package,
       because the other two carry nothing this machine could load, and
       restoring a package this run cannot exercise proves nothing about it. -->
  <ItemGroup Condition="'$(FFAudioPackageVersion)' != '' And $([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="FFAudio.NET.Linux" Version="$(FFAudioPackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(FFAudioPackageVersion)' != '' And $([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="FFAudio.NET.macOS" Version="$(FFAudioPackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(FFAudioPackageVersion)' != '' And $([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="FFAudio.NET.Windows" Version="$(FFAudioPackageVersion)" />
  </ItemGroup>

</Project>
