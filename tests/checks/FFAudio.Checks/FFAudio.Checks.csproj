<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runtime checks shared by desktop, iOS, and Android runners. -->

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Select either the source project or the consumer-facing package. -->
  <ItemGroup Condition="'$(FFAudioPackageVersion)' == ''">
    <ProjectReference Include="../../../src/FFAudio.NET/FFAudio.NET.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(FFAudioPackageVersion)' != ''">
    <PackageReference Include="FFAudio.NET" Version="$(FFAudioPackageVersion)" />
  </ItemGroup>

</Project>
