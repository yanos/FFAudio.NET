<Project Sdk="Microsoft.NET.Sdk">

  <!-- Minimal iOS host for the shared runtime checks. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>12.2</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>FFAudio.Checks.iOS</RootNamespace>
    <ApplicationId>com.yanos.ffaudio.checks</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Default to an unsigned simulator build; use ios-arm64 for devices. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">iossimulator-arm64</RuntimeIdentifier>
    <ProvisioningType Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">automatic</ProvisioningType>
    <ProvisioningType Condition="'$(RuntimeIdentifier)' != 'ios-arm64'">manual</ProvisioningType>

    <!-- This minimal runner intentionally retains UIWindow instead of scenes. -->
    <NoWarn>$(NoWarn);CA1422</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FFAudio.Checks\FFAudio.Checks.csproj" />
  </ItemGroup>

  <!-- Use the tree framework directly, or let the platform package inject it. -->
  <ItemGroup Condition="'$(FFAudioPackageVersion)' != ''">
    <PackageReference Include="FFAudio.NET.iOS" Version="$(FFAudioPackageVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(FFAudioPackageVersion)' == '' And $(RuntimeIdentifier.StartsWith('iossimulator'))">
    <NativeReference Include="..\..\..\native\artifacts\ios\ios-simulator\ffaudio.framework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>
  <ItemGroup Condition="'$(FFAudioPackageVersion)' == '' And !$(RuntimeIdentifier.StartsWith('iossimulator'))">
    <NativeReference Include="..\..\..\native\artifacts\ios\ios-device\ffaudio.framework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

</Project>
