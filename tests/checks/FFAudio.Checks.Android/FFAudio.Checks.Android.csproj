<Project Sdk="Microsoft.NET.Sdk">

  <!-- Minimal Android host for the shared runtime checks. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>FFAudio.Checks.Android</RootNamespace>
    <ApplicationId>com.yanos.ffaudio.checks</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>False</AndroidEnableProfiledAot>

    <!-- adb installs the APK directly, so it must contain managed assemblies. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FFAudio.Checks\FFAudio.Checks.csproj" />
  </ItemGroup>

  <!-- Use tree natives directly, or let the platform package inject them. -->
  <ItemGroup Condition="'$(FFAudioPackageVersion)' != ''">
    <PackageReference Include="FFAudio.NET.Android" Version="$(FFAudioPackageVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(FFAudioPackageVersion)' == ''">
    <AndroidNativeLibrary Include="..\..\..\native\artifacts\android\arm64-v8a\libffaudio.so">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="..\..\..\native\artifacts\android\x86_64\libffaudio.so">
      <Abi>x86_64</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="..\..\..\native\artifacts\android\armeabi-v7a\libffaudio.so">
      <Abi>armeabi-v7a</Abi>
    </AndroidNativeLibrary>
  </ItemGroup>

</Project>
