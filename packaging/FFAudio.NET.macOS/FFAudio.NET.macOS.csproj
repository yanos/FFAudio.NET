<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>FFAudio.NET.macOS</PackageId>
    <Description>The macOS native decoder for FFAudio.NET (arm64). Reference this alongside FFAudio.NET to ship a decoder with a macOS app.</Description>
    <PayloadProbe>$(MSBuildThisFileDirectory)../../native/artifacts/macos/libffaudio.dylib</PayloadProbe>
  </PropertyGroup>

  <!-- Only the tested osx-arm64 RID is packaged. -->
  <ItemGroup>
    <None Include="../../native/artifacts/macos/libffaudio.dylib"
          Pack="true" PackagePath="runtimes/osx-arm64/native/" />
  </ItemGroup>

</Project>
