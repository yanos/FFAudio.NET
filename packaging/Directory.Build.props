<Project>

  <!-- The root one first, or these projects get no MinVer and therefore no
       version: the SDK stops at the nearest Directory.Build.props it finds. -->
  <Import Project="../Directory.Build.props" />

  <!-- What the five per-platform native packages have in common, which is
       almost everything. Each one is a payload and no code at all: the
       decoder is a .dylib, a .so, a .dll or a .framework, and the managed
       binding that P/Invokes into it lives in FFAudio.NET, which none of
       these depend on. That is deliberate - a consumer references the binding
       plus whichever payloads their app actually ships, and a Windows FFmpeg
       is ~70MB where an iOS slice is 1.9MB.

       netstandard2.0 because it has to be something and nothing here is
       compiled. The assets are resolved by RID (desktop) or injected by a
       .targets file (mobile), neither of which cares what the package's own
       framework says. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>

    <!-- NU5128: no lib/ folder. NU5100/NU5118: binaries somewhere other than
         lib/. All three are NuGet telling us this is not an ordinary library
         package, which is correct and is the point. -->
    <NoWarn>$(NoWarn);NU5128;NU5100;NU5118</NoWarn>

    <Authors>yanos</Authors>
    <Copyright>Copyright (c) yanos</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/yanos/FFAudio.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yanos/FFAudio.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ffmpeg;audio;decode;pcm;decoder;native</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The licence terms travel with the binary that is under them. These
         packages are the only artifacts that actually contain FFmpeg. -->
    <None Include="../../NOTICE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- A payload package with no payload is the failure this phase is most
       likely to produce: the natives are built by scripts CI runs in other
       jobs, and a missing download would otherwise pack an empty package and
       publish it. Each project sets $(PayloadProbe) to one file that must
       exist. -->
  <Target Name="EnsurePayloadExists" BeforeTargets="GenerateNuspec"
          Condition="'$(PayloadProbe)' != ''">
    <Error Condition="!Exists('$(PayloadProbe)')"
           Text="No native payload at $(PayloadProbe). Build it first - see README.md's 'Building the natives' - or, in CI, check that the artifact download ran." />
  </Target>

</Project>
