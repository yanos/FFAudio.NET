<Project>

  <!-- Preserve the repository-wide MinVer settings. -->
  <Import Project="../Directory.Build.props" />

  <!-- Shared settings for native-only payload packages. netstandard2.0 keeps
       them installable without implying a managed assembly is included. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>

    <!-- Suppress warnings expected for native-only packages without lib/. -->
    <NoWarn>$(NoWarn);NU5128;NU5100;NU5118</NoWarn>

    <Authors>yanos</Authors>
    <Copyright>Copyright (c) yanos</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/yanos/FFAudio.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yanos/FFAudio.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ffmpeg;audio;decode;pcm;decoder;native</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include license notices with FFmpeg-bearing payloads. -->
    <None Include="../../NOTICE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Prevent publishing a package when its separately built payload is missing. -->
  <Target Name="EnsurePayloadExists" BeforeTargets="GenerateNuspec"
          Condition="'$(PayloadProbe)' != ''">
    <Error Condition="!Exists('$(PayloadProbe)')"
           Text="No native payload at $(PayloadProbe). Build it first - see README.md's 'Building the natives' - or, in CI, check that the artifact download ran." />
  </Target>

</Project>
