<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>FFAudio.NET.Linux</PackageId>
    <Description>The Linux native decoder for FFAudio.NET (x64). Reference this alongside FFAudio.NET to ship a decoder with a Linux app.</Description>
    <PayloadProbe>$(MSBuildThisFileDirectory)../../native/artifacts/linux/libffaudio.so</PayloadProbe>
  </PropertyGroup>

  <!-- Links against the distribution's own FFmpeg rather than carrying one,
       so this package is the façade alone - a few tens of kilobytes - and the
       machine it runs on supplies libavformat and friends. That is also what
       keeps the LGPL uncomplicated here: the FFmpeg stays replaceable because
       it was never ours. -->
  <ItemGroup>
    <None Include="../../native/artifacts/linux/libffaudio.so"
          Pack="true" PackagePath="runtimes/linux-x64/native/" />
  </ItemGroup>

</Project>
