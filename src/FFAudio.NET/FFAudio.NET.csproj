<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <!-- Required by zero-copy Stream callbacks and native buffers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>FFAudio</RootNamespace>
    <AssemblyName>FFAudio.NET</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>FFAudio.NET</PackageId>
    <Description>A narrow, audio-only façade over FFmpeg's decode libraries: open a file or a Stream, ask what PCM it holds, read interleaved samples, seek, close. Sixteen functions, four sample formats (S16, packed S24, S32, F32), and static natives for iOS and Android as well as the desktops.</Description>
    <PackageTags>ffmpeg;audio;decode;pcm;decoder;flac;alac;mp3;aac;opus</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>yanos</Authors>
    <Copyright>Copyright (c) yanos</Copyright>
    <PackageProjectUrl>https://github.com/yanos/FFAudio.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yanos/FFAudio.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Emit a symbol package alongside the SDK-generated NuGet package. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Enable source debugging for packaged builds and generated files. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Native payloads ship in separate platform packages. -->
    <IncludeBuildOutput>true</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only logging abstractions are needed for demuxer-hint warnings. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>
</Project>
